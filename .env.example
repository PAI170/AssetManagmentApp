# Copiar a .env en el servidor y llenar con valores reales. Nunca commitear .env.

DB_NAME=assetmanagementapp
DB_USER=assetmanagementapp
DB_PASSWORD=
DB_ROOT_PASSWORD=

APP_PORT=8081

SEED_ADMIN_EMAIL=admin@rodcast.local
SEED_ADMIN_PASSWORD=

# Cloudflare Turnstile (challenges.cloudflare.com > Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Token del túnel dedicado a esta app (Cloudflare Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
