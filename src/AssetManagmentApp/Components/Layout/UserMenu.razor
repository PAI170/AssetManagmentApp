@rendermode InteractiveServer
@implements IDisposable
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="user-menu-bar">
            <AuthorizeView Roles="Admin" Context="adminContext">
                <Authorized>
                    <a href="solicitudes" class="user-menu-bell" title="Solicitudes pendientes">
                        <i class="bi bi-bell fs-5 user-menu-icon" aria-hidden="true"></i>
                        @if (pendientes > 0)
                        {
                            <span class="user-menu-badge">@(pendientes > 99 ? "99+" : pendientes)</span>
                        }
                    </a>
                </Authorized>
                <NotAuthorized>
                    <i class="bi bi-bell fs-5 user-menu-icon" aria-hidden="true"></i>
                </NotAuthorized>
            </AuthorizeView>

            <div class="user-menu-profile">
                <button type="button" class="user-menu-circle" @onclick="AlternarMenu">@Inicial(context)</button>

                @if (mostrarMenu)
                {
                    <div class="user-menu-dropdown">
                        <div class="user-menu-name">@Nombre(context)</div>
                        <div class="user-menu-email">@context.User.Identity?.Name</div>
                        <hr />
                        <form method="post" action="/Account/Logout">
                            <button type="submit" class="user-menu-logout">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool mostrarMenu;

    private static string Nombre(Microsoft.AspNetCore.Components.Authorization.AuthenticationState context)
    {
        var nombre = context.User.FindFirst(ApplicationUserClaimsPrincipalFactory.NombreClaimType)?.Value;
        return string.IsNullOrWhiteSpace(nombre) ? (context.User.Identity?.Name ?? "Usuario") : nombre;
    }

    private static string Inicial(Microsoft.AspNetCore.Components.Authorization.AuthenticationState context)
    {
        var nombre = Nombre(context);
        return nombre.Length == 0 ? "?" : nombre.Trim()[0].ToString().ToUpperInvariant();
    }

    private void AlternarMenu() => mostrarMenu = !mostrarMenu;

    private int pendientes;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CargarPendientesAsync();
        _ = SondearPendientesAsync(cts.Token);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CargarPendientesAsync();
        await InvokeAsync(StateHasChanged);
    }

    // El circuito de Blazor Server no genera trafico HTTP mientras el usuario interactua
    // dentro de una pagina (todo va por el WebSocket), asi que la campanita solo se
    // refrescaba al navegar. Este sondeo periodico la mantiene al dia aunque el usuario
    // se quede quieto en una sola pantalla.
    private async Task SondearPendientesAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await CargarPendientesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Componente destruido (navegacion fuera del layout, circuito cerrado, etc.).
        }
    }

    private async Task CargarPendientesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        pendientes = await db.SolicitudesCorreccion.CountAsync(s => s.Estado == EstadoSolicitud.Pendiente);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        cts.Cancel();
        cts.Dispose();
    }
}
