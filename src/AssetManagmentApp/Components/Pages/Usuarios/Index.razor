@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject CurrentUserService CurrentUser

<PageTitle>Usuarios</PageTitle>

<PageHeader Titulo="Usuarios" />

<div class="page-card">

<AlertBox Mensaje="@mensaje" Tipo="success" />
<AlertBox Mensaje="@errorMessage" />

@if (usuarios is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in usuarios)
            {
                <tr>
                    <td>@fila.Usuario.Nombre</td>
                    <td>@fila.Usuario.Email</td>
                    <td>@fila.Rol</td>
                    <td>
                        @if (!fila.Usuario.Activo)
                        {
                            <span class="badge bg-secondary">Desactivado</span>
                        }
                        else if (EstaBloqueado(fila.Usuario))
                        {
                            @if (fila.Usuario.LockoutEnd == DateTimeOffset.MaxValue)
                            {
                                <span class="badge bg-danger">Bloqueado</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Bloqueado hasta @fila.Usuario.LockoutEnd!.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                    </td>
                    <td>
                        @if (cambiandoPasswordId == fila.Usuario.Id)
                        {
                            <div class="d-flex gap-1 align-items-center">
                                <input type="password" class="form-control form-control-sm" placeholder="Nueva contraseña" @bind="nuevaPassword" />
                                <button class="btn btn-sm btn-success" @onclick="() => ConfirmarCambiarPasswordAsync(fila.Usuario)">Confirmar</button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelarCambiarPassword">Cancelar</button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarCambiarPassword(fila.Usuario.Id)">Cambiar contraseña</button>

                                @if (fila.Usuario.Id != usuarioActualId)
                                {
                                    @if (fila.Usuario.Activo)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DesactivarAsync(fila.Usuario)">Desactivar</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ActivarAsync(fila.Usuario)">Activar</button>
                                    }
                                }

                                @if (fila.Usuario.Id != usuarioActualId)
                                {
                                    @if (EstaBloqueado(fila.Usuario))
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => DesbloquearAsync(fila.Usuario)">Desbloquear</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-dark" @onclick="() => BloquearAsync(fila.Usuario)">Bloquear</button>
                                    }
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

</div>

@code {
    private List<FilaUsuario>? usuarios;
    private string? errorMessage;
    private string? mensaje;
    private int? cambiandoPasswordId;
    private string nuevaPassword = string.Empty;
    private int usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        usuarioActualId = await CurrentUser.ObtenerUsuarioActualIdAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var todos = UserManager.Users.OrderBy(u => u.Nombre).ToList();
        var filas = new List<FilaUsuario>();
        foreach (var u in todos)
        {
            var roles = await UserManager.GetRolesAsync(u);
            filas.Add(new FilaUsuario(u, roles.FirstOrDefault() ?? "(sin rol)"));
        }
        usuarios = filas;
    }

    private void IniciarCambiarPassword(int userId)
    {
        cambiandoPasswordId = userId;
        nuevaPassword = string.Empty;
        errorMessage = null;
        mensaje = null;
    }

    private void CancelarCambiarPassword()
    {
        cambiandoPasswordId = null;
    }

    private async Task ConfirmarCambiarPasswordAsync(ApplicationUser usuario)
    {
        errorMessage = null;
        mensaje = null;

        if (nuevaPassword.Length < 8)
        {
            errorMessage = "La contraseña debe tener al menos 8 caracteres.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(usuario);
        var result = await UserManager.ResetPasswordAsync(usuario, token, nuevaPassword);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        cambiandoPasswordId = null;
        mensaje = $"Contraseña actualizada para {usuario.Email}.";
    }

    private async Task DesactivarAsync(ApplicationUser usuario)
    {
        usuario.Activo = false;
        await UserManager.UpdateAsync(usuario);
        mensaje = $"{usuario.Email} desactivado.";
        await CargarAsync();
    }

    private async Task ActivarAsync(ApplicationUser usuario)
    {
        usuario.Activo = true;
        await UserManager.UpdateAsync(usuario);
        mensaje = $"{usuario.Email} activado.";
        await CargarAsync();
    }

    private async Task DesbloquearAsync(ApplicationUser usuario)
    {
        await UserManager.SetLockoutEndDateAsync(usuario, null);
        await UserManager.ResetAccessFailedCountAsync(usuario);
        mensaje = $"{usuario.Email} desbloqueado.";
        await CargarAsync();
    }

    private async Task BloquearAsync(ApplicationUser usuario)
    {
        await UserManager.SetLockoutEnabledAsync(usuario, true);
        await UserManager.SetLockoutEndDateAsync(usuario, DateTimeOffset.MaxValue);
        mensaje = $"{usuario.Email} bloqueado.";
        await CargarAsync();
    }

    private static bool EstaBloqueado(ApplicationUser usuario) =>
        usuario.LockoutEnd is not null && usuario.LockoutEnd > DateTimeOffset.UtcNow;

    private record FilaUsuario(ApplicationUser Usuario, string Rol);
}
