@page "/login"
@layout AssetManagmentApp.Components.Layout.LoginLayout
@using System.ComponentModel.DataAnnotations
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject TurnstileService TurnstileService
@inject IConfiguration Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Iniciar sesión</PageTitle>

@if (!HostEnvironment.IsDevelopment())
{
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}

<div class="login-card">
    <img class="login-logo" src="images/logo.png" alt="Control de Equipos" />
    <div class="login-title">CONTROL DE EQUIPOS</div>
    <div class="login-subtitle">Iniciá sesión para continuar</div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger py-2">@errorMessage</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="LoginUserAsync" FormName="login">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label">Correo</label>
            <InputText class="form-control" @bind-Value="Input.Email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="Input.Password" autocomplete="current-password" />
        </div>
        @if (!HostEnvironment.IsDevelopment())
        {
            <div class="mb-3 cf-turnstile" data-sitekey="@Configuration["Turnstile:SiteKey"]"></div>
        }
        <button type="submit" class="btn btn-login">Iniciar sesión</button>
    </EditForm>

    <div class="login-helper">¿Olvidaste tu contraseña? Pedile a un administrador que te la restablezca.</div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromForm(Name = "cf-turnstile-response")]
    private string? TurnstileToken { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task LoginUserAsync()
    {
        if (!HostEnvironment.IsDevelopment())
        {
            var remoteIp = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();
            var turnstileOk = await TurnstileService.VerificarAsync(TurnstileToken, remoteIp);
            if (!turnstileOk)
            {
                errorMessage = "Verificación de seguridad fallida. Recargá la página e intentá de nuevo.";
                return;
            }
        }

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null && !user.Activo)
        {
            errorMessage = "Esta cuenta está desactivada. Contactá a un administrador.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, isPersistent: true, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(ReturnUrl ?? "/inventario", forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            errorMessage = "Cuenta bloqueada por demasiados intentos fallidos. Probá de nuevo más tarde o pedile a un administrador que la desbloquee.";
        }
        else
        {
            errorMessage = "Correo o contraseña incorrectos.";
        }
    }

    private class InputModel
    {
        [Required(ErrorMessage = "El correo es obligatorio")]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria")]
        public string Password { get; set; } = string.Empty;
    }
}
