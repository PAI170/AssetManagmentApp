@page "/inventario/nuevo"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Activo</PageTitle>

<div class="page-card mb-3">
    <h1 class="mb-0">Nuevo Activo</h1>
</div>

<div class="page-card">

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="nuevoActivo" OnValidSubmit="CrearActivoAsync" class="card card-body" style="max-width: 480px;">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-2">
        <label class="form-label">Placa</label>
        <InputText class="form-control" @bind-Value="nuevoActivo.Placa" />
        @if (nuevoActivo.Cantidad > 1)
        {
            <div class="form-text">Se usará como prefijo: se generarán @nuevoActivo.Cantidad placas automáticas (ej. @(string.IsNullOrWhiteSpace(nuevoActivo.Placa) ? "PREFIJO" : nuevoActivo.Placa.Trim())-001, -002...).</div>
        }
    </div>
    <div class="mb-2">
        <label class="form-label">Tipo de equipo</label>
        <InputSelect class="form-select" @bind-Value="nuevoActivo.TipoEquipoId">
            <option value="0">-- Seleccionar --</option>
            @if (tiposEquipo is not null)
            {
                @foreach (var tipo in tiposEquipo)
                {
                    <option value="@tipo.Id">@tipo.Nombre</option>
                }
            }
        </InputSelect>
    </div>
    <div class="mb-2">
        <label class="form-label">Cantidad</label>
        <InputNumber class="form-control" @bind-Value="nuevoActivo.Cantidad" min="1" />
        <div class="form-text">Para equipos sin placa física individual (ej. andamios): poné una cantidad mayor a 1 y en Placa un prefijo (ej. "ANDAMIO"). Se crea un activo por unidad, cada uno con su propia placa autogenerada, asignable y facturable por separado.</div>
    </div>
    <div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </div>
</EditForm>

</div>

@code {
    private List<TipoEquipo>? tiposEquipo;
    private ActivoFormModel nuevoActivo = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        tiposEquipo = await Db.TiposEquipo.AsNoTracking().OrderBy(t => t.Nombre).ToListAsync();
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/inventario");
    }

    private async Task CrearActivoAsync()
    {
        errorMessage = null;
        var placaBase = nuevoActivo.Placa.Trim();

        if (nuevoActivo.TipoEquipoId <= 0)
        {
            errorMessage = "Seleccioná un tipo de equipo.";
            return;
        }

        if (nuevoActivo.Cantidad < 1)
        {
            errorMessage = "La cantidad debe ser al menos 1.";
            return;
        }

        var placas = nuevoActivo.Cantidad == 1
            ? [placaBase]
            : await GenerarPlacasConsecutivasAsync(placaBase, nuevoActivo.Cantidad);

        var placaDuplicada = await Db.Activos
            .Where(a => placas.Contains(a.Placa))
            .Select(a => a.Placa)
            .FirstOrDefaultAsync();

        if (placaDuplicada is not null)
        {
            errorMessage = $"Ya existe un activo con la placa '{placaDuplicada}'.";
            return;
        }

        var fechaRegistro = DateOnly.FromDateTime(DateTime.Now);
        foreach (var placa in placas)
        {
            Db.Activos.Add(new Activo
            {
                Placa = placa,
                TipoEquipoId = nuevoActivo.TipoEquipoId,
                Estado = EstadoActivo.Disponible,
                ProyectoActualId = null,
                FechaRegistro = fechaRegistro
            });
        }

        try
        {
            await Db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            errorMessage = "Ya existe un activo con alguna de esas placas.";
            return;
        }

        NavigationManager.NavigateTo("/inventario");
    }

    private async Task<List<string>> GenerarPlacasConsecutivasAsync(string prefijo, int cantidad)
    {
        var patron = $"{prefijo}-";
        var sufijosExistentes = await Db.Activos
            .Where(a => a.Placa.StartsWith(patron))
            .Select(a => a.Placa)
            .ToListAsync();

        var maxConsecutivo = 0;
        foreach (var placa in sufijosExistentes)
        {
            if (int.TryParse(placa[patron.Length..], out var numero) && numero > maxConsecutivo)
            {
                maxConsecutivo = numero;
            }
        }

        return Enumerable.Range(maxConsecutivo + 1, cantidad)
            .Select(n => $"{prefijo}-{n:D3}")
            .ToList();
    }

    private class ActivoFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La placa es obligatoria")]
        public string Placa { get; set; } = string.Empty;

        public int TipoEquipoId { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, 500, ErrorMessage = "La cantidad debe ser entre 1 y 500")]
        public int Cantidad { get; set; } = 1;
    }
}
