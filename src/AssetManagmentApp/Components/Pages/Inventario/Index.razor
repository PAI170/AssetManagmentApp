@page "/inventario"
@rendermode InteractiveServer
@attribute [Authorize]
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser

<PageTitle>Inventario</PageTitle>

<PageHeader Titulo="Inventario" />

<div class="page-card">

<AlertBox Mensaje="@errorMessage" />

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label">Estado</label>
        <select class="form-select" @bind="filtroEstado">
            <option value="">Todos</option>
            @foreach (var estado in Enum.GetValues<EstadoActivo>())
            {
                <option value="@estado">@estado.Etiqueta()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Tipo de equipo</label>
        <select class="form-select" @bind="filtroTipoEquipoId">
            <option value="">Todos</option>
            @if (tiposEquipo is not null)
            {
                @foreach (var tipo in tiposEquipo)
                {
                    <option value="@tipo.Id">@tipo.Nombre</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Proyecto actual</label>
        <select class="form-select" @bind="filtroProyectoId">
            <option value="">Todos</option>
            <option value="0">Bodega (sin proyecto)</option>
            @if (proyectos is not null)
            {
                @foreach (var proyecto in proyectos)
                {
                    <option value="@proyecto.Id">@proyecto.Nombre</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="AplicarFiltrosAsync">Filtrar</button>
        <button class="btn btn-outline-secondary" @onclick="LimpiarFiltrosAsync">Limpiar</button>
    </div>
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (seleccionados.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 align-items-end mb-3 p-2 border rounded">
                <div><strong>@seleccionados.Count</strong> seleccionado(s)</div>
                <div>
                    <label class="form-label mb-0">Acción</label>
                    <select class="form-select form-select-sm" @bind="bulkAccion">
                        <option value="asignar">Asignar a proyecto</option>
                        <option value="estado">Cambiar estado</option>
                        <option value="eliminar">Eliminar</option>
                    </select>
                </div>
                @if (bulkAccion == "asignar")
                {
                    <div>
                        <label class="form-label mb-0">Proyecto</label>
                        <select class="form-select form-select-sm" @bind="bulkProyectoId">
                            <option value="0">-- Proyecto --</option>
                            @if (proyectos is not null)
                            {
                                @foreach (var proyecto in proyectos)
                                {
                                    <option value="@proyecto.Id">@proyecto.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0">Fecha traslado</label>
                        <input type="date" class="form-control form-control-sm" @bind="bulkFecha" max="@fechaMaxima" />
                    </div>
                    <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="ConfirmarAsignarMasivoAsync">Aplicar</button>
                }
                else if (bulkAccion == "estado")
                {
                    <div>
                        <label class="form-label mb-0">Nuevo estado</label>
                        <select class="form-select form-select-sm" @bind="bulkNuevoEstado">
                            @foreach (var estado in Enum.GetValues<EstadoActivo>())
                            {
                                <option value="@estado">@estado.Etiqueta()</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0">Observación</label>
                        <input class="form-control form-control-sm" @bind="bulkObservacion" />
                    </div>
                    <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="ConfirmarCambiarEstadoMasivoAsync">Aplicar</button>
                }
                else if (bulkAccion == "eliminar")
                {
                    <div class="text-danger">Se omiten los que estén Asignados a un proyecto.</div>
                    <button class="btn btn-sm btn-danger" disabled="@procesando" @onclick="ConfirmarEliminarMasivoAsync">Eliminar seleccionados</button>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarSeleccion">Cancelar selección</button>
            </div>
        }
    </Authorized>
</AuthorizeView>

@if (activos is null)
{
    <p><em>Cargando...</em></p>
}
else if (activos.Count == 0)
{
    <p><em>No hay activos que coincidan con el filtro.</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <input type="checkbox" class="form-check-input" checked="@TodosSeleccionados" @onchange="ToggleSeleccionarTodos" title="Seleccionar todos" />
                        </Authorized>
                    </AuthorizeView>
                </th>
                <th>Placa</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Proyecto actual</th>
                <th>Fecha registro</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var activo in activos)
            {
                <tr>
                    <td>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <input type="checkbox" class="form-check-input" checked="@seleccionados.Contains(activo.Id)" @onchange="e => ToggleSeleccion(activo.Id, (bool)e.Value!)" />
                            </Authorized>
                        </AuthorizeView>
                    </td>
                    <td>@activo.Placa</td>
                    <td>@activo.TipoEquipo.Nombre</td>
                    <td>@activo.Estado.Etiqueta()</td>
                    <td>@(activo.ProyectoActual?.Nombre ?? "Bodega")</td>
                    <td>@activo.FechaRegistro.ToString("dd/MM/yyyy")</td>
                    <td>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                @if (filaAccionId == activo.Id && filaAccionTipo == "asignar")
                                {
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex gap-1 align-items-center">
                                            <select class="form-select form-select-sm" @bind="accionProyectoId">
                                                <option value="0">-- Proyecto --</option>
                                                @if (proyectos is not null)
                                                {
                                                    @foreach (var proyecto in proyectos)
                                                    {
                                                        <option value="@proyecto.Id">@proyecto.Nombre</option>
                                                    }
                                                }
                                            </select>
                                            <input type="date" class="form-control form-control-sm" @bind="accionFechaTraslado" max="@fechaMaxima" />
                                        </div>
                                        <div class="small border rounded px-2 py-1">
                                            ¿Asignar "@activo.Placa" a "@NombreProyecto(accionProyectoId)" desde el @accionFechaTraslado.ToString("dd/MM/yyyy")?
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="() => ConfirmarAsignarAsync(activo)">Confirmar</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="CancelarAccion">Cancelar</button>
                                        </div>
                                    </div>
                                }
                                else if (filaAccionId == activo.Id && filaAccionTipo == "retornar")
                                {
                                    <div class="d-flex flex-column gap-1">
                                        <input type="date" class="form-control form-control-sm" @bind="accionFechaTraslado" max="@fechaMaxima" />
                                        <div class="small border rounded px-2 py-1">
                                            ¿Retornar "@activo.Placa" a bodega el @accionFechaTraslado.ToString("dd/MM/yyyy")?
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="() => ConfirmarRetornarAsync(activo)">Confirmar</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="CancelarAccion">Cancelar</button>
                                        </div>
                                    </div>
                                }
                                else if (filaAccionId == activo.Id && filaAccionTipo == "estado")
                                {
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex gap-1 align-items-center">
                                            <select class="form-select form-select-sm" @bind="accionNuevoEstado">
                                                @foreach (var estado in Enum.GetValues<EstadoActivo>())
                                                {
                                                    <option value="@estado">@estado.Etiqueta()</option>
                                                }
                                            </select>
                                            <input class="form-control form-control-sm" placeholder="Observación" @bind="accionObservacion" />
                                        </div>
                                        <div class="small border rounded px-2 py-1">
                                            ¿Cambiar estado de "@activo.Placa" a "@accionNuevoEstado.Etiqueta()"?
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="() => ConfirmarCambiarEstadoAsync(activo)">Confirmar</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="CancelarAccion">Cancelar</button>
                                        </div>
                                    </div>
                                }
                                else if (filaAccionId == activo.Id && filaAccionTipo == "eliminar")
                                {
                                    <div class="d-flex gap-1 align-items-center">
                                        <span class="text-danger">¿Eliminar "@activo.Placa"?</span>
                                        <button class="btn btn-sm btn-danger" disabled="@procesando" @onclick="() => ConfirmarEliminarAsync(activo)">Confirmar</button>
                                        <button class="btn btn-sm btn-secondary" @onclick="CancelarAccion">Cancelar</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex gap-1">
                                        @if (activo.Estado == EstadoActivo.Disponible)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirAsignar(activo)">Asignar</button>
                                        }
                                        @if (activo.ProyectoActualId is not null)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => AbrirRetornar(activo)">Retornar a bodega</button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirCambiarEstado(activo)">Cambiar estado</button>
                                        @if (activo.Estado != EstadoActivo.Asignado)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirEliminar(activo)">Eliminar</button>
                                        }
                                    </div>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

</div>

@code {
    private List<Activo>? activos;
    private List<TipoEquipo>? tiposEquipo;
    private List<Proyecto>? proyectos;

    private string filtroEstado = "";
    private string filtroTipoEquipoId = "";
    private string filtroProyectoId = "";

    private string? errorMessage;
    private bool procesando;

    private int? filaAccionId;
    private string filaAccionTipo = "";
    private int accionProyectoId;
    private DateOnly accionFechaTraslado;
    private EstadoActivo accionNuevoEstado;
    private string accionObservacion = "";
    private readonly string fechaMaxima = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");

    private readonly HashSet<int> seleccionados = [];
    private string bulkAccion = "asignar";
    private int bulkProyectoId;
    private DateOnly bulkFecha = DateOnly.FromDateTime(DateTime.Now);
    private EstadoActivo bulkNuevoEstado;
    private string bulkObservacion = "";

    protected override async Task OnInitializedAsync()
    {
        tiposEquipo = await Db.TiposEquipo.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Nombre).ToListAsync();
        proyectos = await Db.Proyectos.AsNoTracking().OrderBy(p => p.Nombre).ToListAsync();
        await CargarActivosAsync();
    }

    private async Task CargarActivosAsync()
    {
        var query = Db.Activos
            .AsNoTracking()
            .Include(a => a.TipoEquipo)
            .Include(a => a.ProyectoActual)
            .Where(a => !a.Eliminado)
            .AsQueryable();

        if (Enum.TryParse<EstadoActivo>(filtroEstado, out var estado))
        {
            query = query.Where(a => a.Estado == estado);
        }

        if (int.TryParse(filtroTipoEquipoId, out var tipoEquipoId) && tipoEquipoId > 0)
        {
            query = query.Where(a => a.TipoEquipoId == tipoEquipoId);
        }

        if (int.TryParse(filtroProyectoId, out var proyectoId))
        {
            query = proyectoId == 0
                ? query.Where(a => a.ProyectoActualId == null)
                : query.Where(a => a.ProyectoActualId == proyectoId);
        }

        activos = await query.OrderBy(a => a.Placa).ToListAsync();
    }

    private async Task AplicarFiltrosAsync()
    {
        seleccionados.Clear();
        await CargarActivosAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtroEstado = "";
        filtroTipoEquipoId = "";
        filtroProyectoId = "";
        seleccionados.Clear();
        await CargarActivosAsync();
    }

    private bool TodosSeleccionados =>
        activos is not null
        && activos.Count > 0
        && activos.All(a => seleccionados.Contains(a.Id));

    private void ToggleSeleccion(int activoId, bool marcado)
    {
        if (marcado)
        {
            seleccionados.Add(activoId);
        }
        else
        {
            seleccionados.Remove(activoId);
        }
    }

    private void ToggleSeleccionarTodos(ChangeEventArgs e)
    {
        var marcar = e.Value is bool valor && valor;

        if (!marcar)
        {
            seleccionados.Clear();
            return;
        }

        if (activos is null)
        {
            return;
        }

        foreach (var activo in activos)
        {
            seleccionados.Add(activo.Id);
        }
    }

    private void LimpiarSeleccion()
    {
        seleccionados.Clear();
        bulkAccion = "asignar";
        errorMessage = null;
    }

    private void AbrirAsignar(Activo activo)
    {
        filaAccionId = activo.Id;
        filaAccionTipo = "asignar";
        accionProyectoId = 0;
        accionFechaTraslado = DateOnly.FromDateTime(DateTime.Now);
        errorMessage = null;
    }

    private void AbrirRetornar(Activo activo)
    {
        filaAccionId = activo.Id;
        filaAccionTipo = "retornar";
        accionFechaTraslado = DateOnly.FromDateTime(DateTime.Now);
        errorMessage = null;
    }

    private void AbrirCambiarEstado(Activo activo)
    {
        filaAccionId = activo.Id;
        filaAccionTipo = "estado";
        accionNuevoEstado = activo.Estado;
        accionObservacion = "";
        errorMessage = null;
    }

    private string NombreProyecto(int proyectoId) =>
        proyectos?.FirstOrDefault(p => p.Id == proyectoId)?.Nombre ?? "-- sin elegir --";

    private void AbrirEliminar(Activo activo)
    {
        filaAccionId = activo.Id;
        filaAccionTipo = "eliminar";
        errorMessage = null;
    }

    private void CancelarAccion()
    {
        filaAccionId = null;
        filaAccionTipo = "";
        errorMessage = null;
    }

    private async Task ConfirmarAsignarAsync(Activo activoOriginal)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            if (accionProyectoId <= 0)
            {
                errorMessage = "Seleccioná un proyecto.";
                return;
            }

            var hoy = DateOnly.FromDateTime(DateTime.Now);
            if (accionFechaTraslado > hoy)
            {
                errorMessage = "La fecha de traslado no puede ser futura.";
                return;
            }

            var activo = await Db.Activos.FirstOrDefaultAsync(a => a.Id == activoOriginal.Id);
            if (activo is null || activo.Estado != EstadoActivo.Disponible)
            {
                errorMessage = "El activo ya no está disponible para asignar.";
                filaAccionId = null;
                await CargarActivosAsync();
                return;
            }

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();

            Db.Movimientos.Add(new Movimiento
            {
                ActivoId = activo.Id,
                ProyectoId = accionProyectoId,
                TipoMovimiento = TipoMovimiento.Asignacion,
                EstadoAnterior = EstadoActivo.Disponible,
                EstadoNuevo = EstadoActivo.Asignado,
                FechaMovimiento = accionFechaTraslado.ToDateTime(TimeOnly.FromDateTime(DateTime.Now)),
                UsuarioId = usuarioId
            });

            Db.AsignacionesActivoProyecto.Add(new AsignacionActivoProyecto
            {
                ActivoId = activo.Id,
                ProyectoId = accionProyectoId,
                FechaIngreso = accionFechaTraslado,
                FechaSalida = null,
                FechaUltimoCobro = accionFechaTraslado
            });

            activo.Estado = EstadoActivo.Asignado;
            activo.ProyectoActualId = accionProyectoId;

            await Db.SaveChangesAsync();

            filaAccionId = null;
            await CargarActivosAsync();
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarAsignarMasivoAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            if (bulkProyectoId <= 0)
            {
                errorMessage = "Seleccioná un proyecto.";
                return;
            }

            var hoy = DateOnly.FromDateTime(DateTime.Now);
            if (bulkFecha > hoy)
            {
                errorMessage = "La fecha de traslado no puede ser futura.";
                return;
            }

            var idsSeleccionados = seleccionados.ToList();
            if (idsSeleccionados.Count == 0)
            {
                errorMessage = "No hay activos seleccionados.";
                return;
            }

            var activosDb = await Db.Activos
                .Where(a => idsSeleccionados.Contains(a.Id) && a.Estado == EstadoActivo.Disponible)
                .ToListAsync();

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();

            foreach (var activo in activosDb)
            {
                Db.Movimientos.Add(new Movimiento
                {
                    ActivoId = activo.Id,
                    ProyectoId = bulkProyectoId,
                    TipoMovimiento = TipoMovimiento.Asignacion,
                    EstadoAnterior = EstadoActivo.Disponible,
                    EstadoNuevo = EstadoActivo.Asignado,
                    FechaMovimiento = bulkFecha.ToDateTime(TimeOnly.FromDateTime(DateTime.Now)),
                    UsuarioId = usuarioId
                });

                Db.AsignacionesActivoProyecto.Add(new AsignacionActivoProyecto
                {
                    ActivoId = activo.Id,
                    ProyectoId = bulkProyectoId,
                    FechaIngreso = bulkFecha,
                    FechaSalida = null,
                    FechaUltimoCobro = bulkFecha
                });

                activo.Estado = EstadoActivo.Asignado;
                activo.ProyectoActualId = bulkProyectoId;
            }

            await Db.SaveChangesAsync();

            var faltantes = idsSeleccionados.Count - activosDb.Count;
            seleccionados.Clear();
            bulkProyectoId = 0;
            await CargarActivosAsync();

            if (faltantes > 0)
            {
                errorMessage = $"{faltantes} activo(s) ya no estaban disponibles y no se asignaron.";
            }
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarCambiarEstadoMasivoAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            var idsSeleccionados = seleccionados.ToList();
            if (idsSeleccionados.Count == 0)
            {
                errorMessage = "No hay activos seleccionados.";
                return;
            }

            var activosDb = await Db.Activos
                .Where(a => idsSeleccionados.Contains(a.Id) && a.Estado != bulkNuevoEstado)
                .ToListAsync();

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();
            var observacion = string.IsNullOrWhiteSpace(bulkObservacion) ? null : bulkObservacion.Trim();

            foreach (var activo in activosDb)
            {
                Db.Movimientos.Add(new Movimiento
                {
                    ActivoId = activo.Id,
                    ProyectoId = activo.ProyectoActualId,
                    TipoMovimiento = TipoMovimiento.CambioDeEstado,
                    EstadoAnterior = activo.Estado,
                    EstadoNuevo = bulkNuevoEstado,
                    FechaMovimiento = DateTime.Now,
                    UsuarioId = usuarioId,
                    Observacion = observacion
                });

                activo.Estado = bulkNuevoEstado;
            }

            await Db.SaveChangesAsync();

            var omitidos = idsSeleccionados.Count - activosDb.Count;
            seleccionados.Clear();
            bulkObservacion = "";
            await CargarActivosAsync();

            if (omitidos > 0)
            {
                errorMessage = $"{omitidos} activo(s) ya tenían ese estado y se omitieron.";
            }
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarEliminarMasivoAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            var idsSeleccionados = seleccionados.ToList();
            if (idsSeleccionados.Count == 0)
            {
                errorMessage = "No hay activos seleccionados.";
                return;
            }

            var activosDb = await Db.Activos
                .Where(a => idsSeleccionados.Contains(a.Id) && a.Estado != EstadoActivo.Asignado)
                .ToListAsync();

            var idsCandidatos = activosDb.Select(a => a.Id).ToList();
            var idsConHistorial = (await Db.Movimientos
                    .Where(m => idsCandidatos.Contains(m.ActivoId))
                    .Select(m => m.ActivoId)
                    .Distinct()
                    .ToListAsync())
                .Concat(await Db.AsignacionesActivoProyecto
                    .Where(a => idsCandidatos.Contains(a.ActivoId))
                    .Select(a => a.ActivoId)
                    .Distinct()
                    .ToListAsync())
                .Concat(await Db.ProformaDetalles
                    .Where(d => idsCandidatos.Contains(d.ActivoId))
                    .Select(d => d.ActivoId)
                    .Distinct()
                    .ToListAsync())
                .ToHashSet();

            foreach (var activo in activosDb)
            {
                if (idsConHistorial.Contains(activo.Id))
                {
                    activo.Eliminado = true;
                }
                else
                {
                    Db.Activos.Remove(activo);
                }
            }

            await Db.SaveChangesAsync();

            var omitidos = idsSeleccionados.Count - activosDb.Count;
            seleccionados.Clear();
            await CargarActivosAsync();

            if (omitidos > 0)
            {
                errorMessage = $"{omitidos} activo(s) estaban asignados a un proyecto y se omitieron. Retornalos a bodega primero.";
            }
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarRetornarAsync(Activo activoOriginal)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            var activo = await Db.Activos.FirstOrDefaultAsync(a => a.Id == activoOriginal.Id);
            if (activo is null || activo.ProyectoActualId is null)
            {
                errorMessage = "El activo no está asignado a ningún proyecto actualmente.";
                filaAccionId = null;
                await CargarActivosAsync();
                return;
            }

            var hoy = DateOnly.FromDateTime(DateTime.Now);
            if (accionFechaTraslado > hoy)
            {
                errorMessage = "La fecha de retorno no puede ser futura.";
                return;
            }

            var proyectoAnteriorId = activo.ProyectoActualId;
            var estadoAnterior = activo.Estado;

            var asignacionAbierta = await Db.AsignacionesActivoProyecto
                .Where(a => a.ActivoId == activo.Id && a.FechaSalida == null)
                .OrderByDescending(a => a.FechaIngreso)
                .FirstOrDefaultAsync();

            if (asignacionAbierta is not null && accionFechaTraslado < asignacionAbierta.FechaIngreso)
            {
                errorMessage = "La fecha de retorno no puede ser anterior a la fecha de ingreso al proyecto.";
                return;
            }

            if (asignacionAbierta is not null)
            {
                asignacionAbierta.FechaSalida = accionFechaTraslado;
            }

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();

            Db.Movimientos.Add(new Movimiento
            {
                ActivoId = activo.Id,
                ProyectoId = proyectoAnteriorId,
                TipoMovimiento = TipoMovimiento.RetornoABodega,
                EstadoAnterior = estadoAnterior,
                EstadoNuevo = EstadoActivo.Disponible,
                FechaMovimiento = accionFechaTraslado.ToDateTime(TimeOnly.FromDateTime(DateTime.Now)),
                UsuarioId = usuarioId
            });

            activo.Estado = EstadoActivo.Disponible;
            activo.ProyectoActualId = null;

            await Db.SaveChangesAsync();

            filaAccionId = null;
            await CargarActivosAsync();
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarEliminarAsync(Activo activoOriginal)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            var activo = await Db.Activos.FirstOrDefaultAsync(a => a.Id == activoOriginal.Id);
            if (activo is null)
            {
                filaAccionId = null;
                await CargarActivosAsync();
                return;
            }

            if (activo.Estado == EstadoActivo.Asignado)
            {
                errorMessage = "No se puede eliminar un activo asignado a un proyecto. Retornalo a bodega primero.";
                filaAccionId = null;
                return;
            }

            var tieneHistorial = await Db.Movimientos.AnyAsync(m => m.ActivoId == activo.Id)
                || await Db.AsignacionesActivoProyecto.AnyAsync(a => a.ActivoId == activo.Id)
                || await Db.ProformaDetalles.AnyAsync(d => d.ActivoId == activo.Id);

            if (tieneHistorial)
            {
                activo.Eliminado = true;
            }
            else
            {
                Db.Activos.Remove(activo);
            }

            await Db.SaveChangesAsync();

            filaAccionId = null;
            await CargarActivosAsync();
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }

    private async Task ConfirmarCambiarEstadoAsync(Activo activoOriginal)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;

            var activo = await Db.Activos.FirstOrDefaultAsync(a => a.Id == activoOriginal.Id);
            if (activo is null)
            {
                errorMessage = "El activo ya no existe.";
                filaAccionId = null;
                await CargarActivosAsync();
                return;
            }

            if (accionNuevoEstado == activo.Estado)
            {
                errorMessage = "Seleccioná un estado distinto al actual.";
                return;
            }

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();
            var estadoAnterior = activo.Estado;

            Db.Movimientos.Add(new Movimiento
            {
                ActivoId = activo.Id,
                ProyectoId = activo.ProyectoActualId,
                TipoMovimiento = TipoMovimiento.CambioDeEstado,
                EstadoAnterior = estadoAnterior,
                EstadoNuevo = accionNuevoEstado,
                FechaMovimiento = DateTime.Now,
                UsuarioId = usuarioId,
                Observacion = string.IsNullOrWhiteSpace(accionObservacion) ? null : accionObservacion.Trim()
            });

            activo.Estado = accionNuevoEstado;

            await Db.SaveChangesAsync();

            filaAccionId = null;
            await CargarActivosAsync();
        }
        finally
        {
            Db.ChangeTracker.Clear();
            procesando = false;
        }
    }
}
