@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject ProformaService ProformaService

<PageTitle>Dashboard</PageTitle>

<PageHeader Titulo="Dashboard" />

@if (cargando)
{
    <div class="page-card"><p><em>Cargando...</em></p></div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="dashboard-card accent-orange h-100">
                <div class="dashboard-card-title">Total facturado por proyecto</div>
                <div class="dashboard-stat">₡@totalFacturado.ToString("N2")</div>
                <p class="dashboard-card-subtitle">Consumo acumulado desde el último corte (última proforma generada) de cada proyecto.</p>
                @if (totalesPorProyecto is { Count: > 0 })
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless dashboard-mini-table mb-0">
                            <tbody>
                                @foreach (var fila in totalesPorProyecto)
                                {
                                    <tr>
                                        <td>@fila.ProyectoNombre</td>
                                        <td class="text-end">₡@fila.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No hay consumo pendiente de facturar.</p>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="dashboard-card accent-navy-light h-100">
                <div class="dashboard-card-title">Inventario por estado</div>
                @if (totalActivos == 0)
                {
                    <p class="text-muted small mb-0">No hay activos registrados.</p>
                }
                else
                {
                    <p class="dashboard-card-subtitle mt-0">Total: @totalActivos activos</p>
                    @foreach (var fila in inventarioPorEstado!)
                    {
                        var porcentaje = totalActivos == 0 ? 0 : (double)fila.Cantidad / totalActivos * 100;
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span>@fila.Estado.Etiqueta()</span>
                                <span>@fila.Cantidad (@porcentaje.ToString("N1")%)</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @ClaseColorEstado(fila.Estado)" style="width: @(porcentaje.ToString("N1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="dashboard-card accent-navy h-100">
                <div class="dashboard-card-title">Total de proyectos</div>
                <div class="dashboard-stat">@totalProyectos</div>
                <p class="dashboard-card-subtitle mb-0">@proyectosActivos activo(s) &middot; @proyectosCerrados cerrado(s)</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="dashboard-card accent-orange-dark h-100">
                <div class="dashboard-card-title">Últimos movimientos</div>
                @if (ultimosMovimientos is { Count: > 0 })
                {
                    <div class="table-responsive">
                        <table class="table table-sm dashboard-mini-table mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Activo</th>
                                    <th>Proyecto</th>
                                    <th>Movimiento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in ultimosMovimientos)
                                {
                                    <tr>
                                        <td>@mov.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@mov.Activo.Placa</td>
                                        <td>@(mov.Proyecto?.Nombre ?? "Bodega")</td>
                                        <td>@mov.TipoMovimiento.Etiqueta()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No hay movimientos registrados.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;

    private List<TotalPorProyecto>? totalesPorProyecto;
    private decimal totalFacturado;

    private List<InventarioPorEstado>? inventarioPorEstado;
    private int totalActivos;

    private int totalProyectos;
    private int proyectosActivos;
    private int proyectosCerrados;

    private List<Movimiento>? ultimosMovimientos;

    protected override async Task OnInitializedAsync()
    {
        var fechaCorte = DateOnly.FromDateTime(DateTime.Now);

        var consumos = await ProformaService.CalcularConsumoPorProyectoAsync(fechaCorte);
        totalesPorProyecto = consumos
            .Select(c => new TotalPorProyecto(c.ProyectoNombre, c.Total))
            .ToList();
        totalFacturado = totalesPorProyecto.Sum(f => f.Total);

        var conteosCrudos = await Db.Activos
            .AsNoTracking()
            .GroupBy(a => a.Estado)
            .Select(g => new { Estado = g.Key, Cantidad = g.Count() })
            .ToListAsync();

        var conteos = conteosCrudos
            .Select(g => new InventarioPorEstado(g.Estado, g.Cantidad))
            .ToList();

        totalActivos = conteos.Sum(c => c.Cantidad);

        inventarioPorEstado = Enum.GetValues<EstadoActivo>()
            .Select(estado => conteos.FirstOrDefault(c => c.Estado == estado) ?? new InventarioPorEstado(estado, 0))
            .ToList();

        var proyectos = await Db.Proyectos.AsNoTracking().ToListAsync();
        totalProyectos = proyectos.Count;
        proyectosActivos = proyectos.Count(p => p.Estado == EstadoProyecto.Activo);
        proyectosCerrados = proyectos.Count(p => p.Estado == EstadoProyecto.Cerrado);

        ultimosMovimientos = await Db.Movimientos
            .AsNoTracking()
            .Include(m => m.Activo)
            .Include(m => m.Proyecto)
            .OrderByDescending(m => m.FechaMovimiento)
            .Take(10)
            .ToListAsync();

        cargando = false;
    }

    private static string ClaseColorEstado(EstadoActivo estado) => estado switch
    {
        EstadoActivo.Disponible => "bg-success",
        EstadoActivo.Asignado => "bg-primary",
        EstadoActivo.EnReparacion => "bg-warning",
        EstadoActivo.Danado => "bg-danger",
        _ => "bg-secondary"
    };

    private record TotalPorProyecto(string ProyectoNombre, decimal Total);
    private record InventarioPorEstado(EstadoActivo Estado, int Cantidad);
}
