@page "/tipos-equipo"
@rendermode InteractiveServer
@attribute [Authorize]
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Tipo de Equipo</PageTitle>

<div class="page-card mb-3">
    <h1 class="mb-0">Tipo de Equipo</h1>
</div>

<div class="page-card">

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (tipos is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio por día (₡)</th>
                <th>Descripción</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tipo in tipos)
            {
                <tr>
                    @if (editandoId == tipo.Id)
                    {
                        <td><InputText class="form-control" @bind-Value="edicion.Nombre" /></td>
                        <td><InputNumber class="form-control" @bind-Value="edicion.PrecioPorDia" /></td>
                        <td><InputText class="form-control" @bind-Value="edicion.Descripcion" /></td>
                        <td>
                            <button class="btn btn-sm btn-success" @onclick="() => GuardarEdicionAsync(tipo)">Guardar</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelarEdicion">Cancelar</button>
                        </td>
                    }
                    else if (eliminandoId == tipo.Id)
                    {
                        <td colspan="3" class="text-danger">¿Eliminar "@tipo.Nombre"?</td>
                        <td>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarEliminarAsync(tipo)">Confirmar</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                        </td>
                    }
                    else
                    {
                        <td>@tipo.Nombre</td>
                        <td>@tipo.PrecioPorDia.ToString("N2")</td>
                        <td>@tipo.Descripcion</td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => IniciarEdicion(tipo)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => IniciarEliminar(tipo)">Eliminar</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>
}

</div>

@code {
    private List<TipoEquipo>? tipos;
    private int? editandoId;
    private int? eliminandoId;
    private TipoEquipoFormModel edicion = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        tipos = await Db.TiposEquipo.AsNoTracking().Where(t => !t.Eliminado).OrderBy(t => t.Nombre).ToListAsync();
    }

    private void IniciarEdicion(TipoEquipo tipo)
    {
        editandoId = tipo.Id;
        eliminandoId = null;
        edicion = new TipoEquipoFormModel
        {
            Nombre = tipo.Nombre,
            PrecioPorDia = tipo.PrecioPorDia,
            Descripcion = tipo.Descripcion
        };
    }

    private void CancelarEdicion()
    {
        editandoId = null;
    }

    private void IniciarEliminar(TipoEquipo tipo)
    {
        eliminandoId = tipo.Id;
        editandoId = null;
        errorMessage = null;
    }

    private void CancelarEliminar()
    {
        eliminandoId = null;
    }

    private async Task ConfirmarEliminarAsync(TipoEquipo tipoOriginal)
    {
        errorMessage = null;

        var tipo = await Db.TiposEquipo.FirstOrDefaultAsync(t => t.Id == tipoOriginal.Id);
        if (tipo is null)
        {
            eliminandoId = null;
            await CargarAsync();
            return;
        }

        var tieneActivos = await Db.Activos.AnyAsync(a => a.TipoEquipoId == tipo.Id);

        if (tieneActivos)
        {
            tipo.Eliminado = true;
        }
        else
        {
            Db.TiposEquipo.Remove(tipo);
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        eliminandoId = null;
        await CargarAsync();
    }

    private async Task GuardarEdicionAsync(TipoEquipo tipoOriginal)
    {
        errorMessage = null;
        var tipo = await Db.TiposEquipo.FirstOrDefaultAsync(t => t.Id == tipoOriginal.Id);
        if (tipo is null)
        {
            errorMessage = "El tipo de equipo ya no existe.";
            editandoId = null;
            await CargarAsync();
            return;
        }

        tipo.Nombre = edicion.Nombre.Trim();
        tipo.Descripcion = string.IsNullOrWhiteSpace(edicion.Descripcion) ? null : edicion.Descripcion.Trim();

        if (edicion.PrecioPorDia != tipo.PrecioPorDia)
        {
            var hoy = DateOnly.FromDateTime(DateTime.Now);

            var precioVigente = await Db.HistorialPreciosTipoEquipo
                .Where(h => h.TipoEquipoId == tipo.Id && h.VigenteHasta == null)
                .OrderByDescending(h => h.VigenteDesde)
                .FirstOrDefaultAsync();

            if (precioVigente is not null && precioVigente.VigenteDesde == hoy)
            {
                // Se creó/cambió hoy mismo: no hay un día real bajo el precio anterior,
                // así que se corrige en el mismo registro en vez de abrir un tramo invertido.
                precioVigente.Precio = edicion.PrecioPorDia;
            }
            else
            {
                if (precioVigente is not null)
                {
                    precioVigente.VigenteHasta = hoy.AddDays(-1);
                }

                Db.HistorialPreciosTipoEquipo.Add(new HistorialPrecioTipoEquipo
                {
                    TipoEquipoId = tipo.Id,
                    Precio = edicion.PrecioPorDia,
                    VigenteDesde = hoy,
                    VigenteHasta = null
                });
            }

            tipo.PrecioPorDia = edicion.PrecioPorDia;
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        editandoId = null;
        await CargarAsync();
    }

    private class TipoEquipoFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor a 0")]
        public decimal PrecioPorDia { get; set; }

        public string? Descripcion { get; set; }
    }
}
