@page "/solicitudes"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using AssetManagmentApp.Data
@using AssetManagmentApp.Models
@using AssetManagmentApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject CurrentUserService CurrentUser
@inject SolicitudCorreccionService SolicitudCorreccion

<PageTitle>Solicitudes de Corrección</PageTitle>

<PageHeader Titulo="Solicitudes de Corrección" />

<div class="page-card">

<AlertBox Mensaje="@mensaje" Tipo="success" />
<AlertBox Mensaje="@errorMessage" />

<div class="row g-2 mb-3 align-items-end filtros-sticky">
    <div class="col-auto">
        <label class="form-label">Estado</label>
        <select class="form-select" @bind="filtroEstado" @bind:after="CargarAsync">
            <option value="@nameof(EstadoSolicitud.Pendiente)">Pendientes</option>
            <option value="@nameof(EstadoSolicitud.Aprobada)">Aprobadas</option>
            <option value="@nameof(EstadoSolicitud.Rechazada)">Rechazadas</option>
            <option value="">Todas</option>
        </select>
    </div>
    @if (PendientesVisibles.Count > 0)
    {
        <div class="col-auto">
            <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="AbrirAprobarTodas">Aprobar todas</button>
            <button class="btn btn-sm btn-outline-danger" disabled="@procesando" @onclick="AbrirRechazarTodas">Rechazar todas</button>
        </div>
    }
</div>

@if (seleccionados.Count > 0)
{
    <div class="d-flex flex-wrap gap-2 align-items-end mb-3 p-2 border rounded">
        <div><strong>@seleccionados.Count</strong> seleccionada(s)</div>
        @if (bulkAccion == "rechazar")
        {
            <div>
                <label class="form-label mb-0">Motivo del rechazo (opcional)</label>
                <input class="form-control form-control-sm" @bind="bulkRechazoComentario" />
            </div>
            <button class="btn btn-sm btn-danger" disabled="@procesando" @onclick="ConfirmarRechazarMasivoAsync">Confirmar rechazo</button>
        }
        else
        {
            <div class="text-muted small">Se van a aprobar las @seleccionados.Count solicitud(es) seleccionadas.</div>
            <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="ConfirmarAprobarMasivoAsync">Confirmar aprobación</button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarSeleccion">Cancelar selección</button>
    </div>
}

@if (solicitudes is null)
{
    <p><em>Cargando...</em></p>
}
else if (solicitudes.Count == 0)
{
    <p><em>No hay solicitudes que coincidan con el filtro.</em></p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>
                    @if (PendientesVisibles.Count > 0)
                    {
                        <input type="checkbox" class="form-check-input" checked="@TodosSeleccionados" @onchange="ToggleSeleccionarTodos" title="Seleccionar todas las pendientes" />
                    }
                </th>
                <th>Fecha</th>
                <th>Activo</th>
                <th>De</th>
                <th>A</th>
                <th>Motivo</th>
                <th>Solicitó</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in solicitudes)
            {
                <tr>
                    <td>
                        @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                        {
                            <input type="checkbox" class="form-check-input" checked="@seleccionados.Contains(solicitud.Id)" @onchange="e => ToggleSeleccion(solicitud.Id, (bool)e.Value!)" />
                        }
                    </td>
                    <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@solicitud.Asignacion.Activo.Placa</td>
                    <td>
                        @if (solicitud.ProyectoOriginalId != solicitud.ProyectoNuevoId)
                        {
                            <div>@solicitud.ProyectoOriginal.Nombre</div>
                        }
                        @if (solicitud.FechaIngresoOriginal != solicitud.FechaIngresoNueva)
                        {
                            <div class="text-muted small">Ingreso: @solicitud.FechaIngresoOriginal.ToString("dd/MM/yyyy")</div>
                        }
                    </td>
                    <td>
                        @if (solicitud.ProyectoOriginalId != solicitud.ProyectoNuevoId)
                        {
                            <div>@solicitud.ProyectoNuevo.Nombre</div>
                        }
                        @if (solicitud.FechaIngresoOriginal != solicitud.FechaIngresoNueva)
                        {
                            <div class="text-muted small">Ingreso: @solicitud.FechaIngresoNueva.ToString("dd/MM/yyyy")</div>
                        }
                    </td>
                    <td>@solicitud.Motivo</td>
                    <td>@solicitud.UsuarioSolicita.Nombre</td>
                    <td>
                        <span class="badge @ClaseColorEstado(solicitud.Estado)">@solicitud.Estado.Etiqueta()</span>
                        @if (solicitud.Estado != EstadoSolicitud.Pendiente)
                        {
                            <div class="small text-muted">
                                @solicitud.UsuarioResuelve?.Nombre · @solicitud.FechaResolucion?.ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(solicitud.ComentarioResolucion))
                                {
                                    <div>@solicitud.ComentarioResolucion</div>
                                }
                            </div>
                        }
                    </td>
                    <td>
                        @if (solicitud.Estado == EstadoSolicitud.Pendiente)
                        {
                            @if (filaAccionId == solicitud.Id && filaAccionTipo == "rechazar")
                            {
                                <div class="d-flex flex-column gap-1">
                                    <input class="form-control form-control-sm" placeholder="Motivo del rechazo (opcional)" @bind="rechazoComentario" />
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-danger" disabled="@procesando" @onclick="() => ConfirmarRechazarAsync(solicitud)">Confirmar rechazo</button>
                                        <button class="btn btn-sm btn-secondary" @onclick="CancelarAccion">Cancelar</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-success" disabled="@procesando" @onclick="() => AprobarAsync(solicitud)">Aprobar</button>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@procesando" @onclick="() => AbrirRechazar(solicitud)">Rechazar</button>
                                </div>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

</div>

@code {
    private List<SolicitudCorreccionAsignacion>? solicitudes;
    private string filtroEstado = nameof(EstadoSolicitud.Pendiente);
    private string? errorMessage;
    private string? mensaje;
    private bool procesando;

    private int? filaAccionId;
    private string filaAccionTipo = "";
    private string rechazoComentario = "";

    private readonly HashSet<int> seleccionados = [];
    private string bulkAccion = "aprobar";
    private string bulkRechazoComentario = "";

    private List<SolicitudCorreccionAsignacion> PendientesVisibles =>
        solicitudes?.Where(s => s.Estado == EstadoSolicitud.Pendiente).ToList() ?? [];

    private bool TodosSeleccionados =>
        PendientesVisibles.Count > 0 && PendientesVisibles.All(s => seleccionados.Contains(s.Id));

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var query = Db.SolicitudesCorreccion
            .AsNoTracking()
            .Include(s => s.Asignacion).ThenInclude(a => a.Activo)
            .Include(s => s.ProyectoOriginal)
            .Include(s => s.ProyectoNuevo)
            .Include(s => s.UsuarioSolicita)
            .Include(s => s.UsuarioResuelve)
            .AsQueryable();

        if (Enum.TryParse<EstadoSolicitud>(filtroEstado, out var estado))
        {
            query = query.Where(s => s.Estado == estado);
        }

        solicitudes = await query.OrderByDescending(s => s.FechaSolicitud).ToListAsync();

        var idsVigentes = solicitudes.Select(s => s.Id).ToHashSet();
        seleccionados.RemoveWhere(id => !idsVigentes.Contains(id));
    }

    private void AbrirRechazar(SolicitudCorreccionAsignacion solicitud)
    {
        filaAccionId = solicitud.Id;
        filaAccionTipo = "rechazar";
        rechazoComentario = "";
        errorMessage = null;
        mensaje = null;
    }

    private void CancelarAccion()
    {
        filaAccionId = null;
        filaAccionTipo = "";
    }

    private void ToggleSeleccion(int solicitudId, bool marcado)
    {
        if (marcado)
        {
            seleccionados.Add(solicitudId);
        }
        else
        {
            seleccionados.Remove(solicitudId);
        }
    }

    private void ToggleSeleccionarTodos(ChangeEventArgs e)
    {
        var marcar = e.Value is bool valor && valor;

        if (!marcar)
        {
            seleccionados.Clear();
            return;
        }

        foreach (var solicitud in PendientesVisibles)
        {
            seleccionados.Add(solicitud.Id);
        }
    }

    private void LimpiarSeleccion()
    {
        seleccionados.Clear();
        bulkAccion = "aprobar";
        bulkRechazoComentario = "";
        errorMessage = null;
    }

    private void AbrirAprobarTodas()
    {
        seleccionados.Clear();
        foreach (var solicitud in PendientesVisibles)
        {
            seleccionados.Add(solicitud.Id);
        }
        bulkAccion = "aprobar";
        errorMessage = null;
        mensaje = null;
    }

    private void AbrirRechazarTodas()
    {
        seleccionados.Clear();
        foreach (var solicitud in PendientesVisibles)
        {
            seleccionados.Add(solicitud.Id);
        }
        bulkAccion = "rechazar";
        bulkRechazoComentario = "";
        errorMessage = null;
        mensaje = null;
    }

    private async Task ConfirmarAprobarMasivoAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;
            mensaje = null;

            var idsSeleccionados = seleccionados.ToList();
            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();

            var aprobadas = 0;
            var fallidas = 0;

            foreach (var solicitudId in idsSeleccionados)
            {
                try
                {
                    await SolicitudCorreccion.AprobarAsync(solicitudId, usuarioId);
                    aprobadas++;
                }
                catch (InvalidOperationException)
                {
                    fallidas++;
                }
            }

            LimpiarSeleccion();
            await CargarAsync();

            if (fallidas > 0)
            {
                errorMessage = $"{aprobadas} aprobada(s). {fallidas} no se pudieron aprobar (ya resueltas o la asignación ya no cumple las condiciones).";
            }
            else
            {
                mensaje = $"{aprobadas} solicitud(es) aprobada(s).";
            }
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task ConfirmarRechazarMasivoAsync()
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;
            mensaje = null;

            var idsSeleccionados = seleccionados.ToList();
            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();

            foreach (var solicitudId in idsSeleccionados)
            {
                await SolicitudCorreccion.RechazarAsync(solicitudId, usuarioId, bulkRechazoComentario);
            }

            mensaje = $"{idsSeleccionados.Count} solicitud(es) rechazada(s).";
            LimpiarSeleccion();
            await CargarAsync();
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task AprobarAsync(SolicitudCorreccionAsignacion solicitud)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;
            mensaje = null;

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();
            await SolicitudCorreccion.AprobarAsync(solicitud.Id, usuarioId);

            mensaje = "Solicitud aprobada: la asignación del activo fue corregida.";
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            await CargarAsync();
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task ConfirmarRechazarAsync(SolicitudCorreccionAsignacion solicitud)
    {
        if (procesando)
        {
            return;
        }

        procesando = true;
        try
        {
            errorMessage = null;
            mensaje = null;

            var usuarioId = await CurrentUser.ObtenerUsuarioActualIdAsync();
            await SolicitudCorreccion.RechazarAsync(solicitud.Id, usuarioId, rechazoComentario);

            mensaje = "Solicitud rechazada.";
            filaAccionId = null;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private static string ClaseColorEstado(EstadoSolicitud estado) => estado switch
    {
        EstadoSolicitud.Pendiente => "bg-warning text-dark",
        EstadoSolicitud.Aprobada => "bg-success",
        EstadoSolicitud.Rechazada => "bg-secondary",
        _ => "bg-secondary"
    };
}
